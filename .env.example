# Copy this file to `.env`.
# Compose reads POSTGRES_* and PORT. The API container builds DATABASE_URL
# with host `postgres` on the Compose network. DATABASE_URL below is for
# commands on the host (localhost). Requires PostgreSQL >= 15.

POSTGRES_USER=card
POSTGRES_PASSWORD=card
POSTGRES_DB=business_card
POSTGRES_PORT=5432
PORT=3000
DATABASE_URL="postgresql://card:card@localhost:5432/business_card"
